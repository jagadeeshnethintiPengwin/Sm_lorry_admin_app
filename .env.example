# Every build talks to https://api.simhadritransport.com unless BOTH values
# below say otherwise. The address alone does nothing.
#
# USE_LOCAL_API=false  ->  the deployed API, whatever API_ORIGIN says
# USE_LOCAL_API=true   ->  API_ORIGIN, for an API running on this network
#
# Two values rather than one because this file is inlined at build time and is
# git-ignored, so a leftover address from last week's network used to redirect
# the app on its own, silently. Now going local is something you state.
#
# `localhost` is the handset itself, so a real phone cannot use it — use the
# machine's LAN address. `npm run point-apps` in the repo root writes both
# values for every app at once, and `npm run where` reports what they do.
#
# Release builds ignore both and always use the deployed API.
#
# Metro folds this file into its cache key when it STARTS, so editing it under a
# running bundler changes nothing — restart Metro after editing.
API_ORIGIN=http://localhost:4000
USE_LOCAL_API=false
