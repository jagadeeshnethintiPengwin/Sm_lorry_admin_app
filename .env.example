# Where this app looks for the SMT API in development.
#
# `localhost` is the handset itself, so a real phone cannot use it — point this
# at the machine running the API instead. `npm run point-apps` in the repo root
# fills it in for every app at once.
#
# Production builds ignore this and use https://api.simhadritransport.com.
#
# Metro reads .env at build time: restart it with --reset-cache after editing.
API_ORIGIN=http://localhost:4000
