# React Native 0.87.0-rc.4 is a prerelease, and npm's semver excludes
# prereleases from ordinary ranges: `0.87.0-rc.4` does not satisfy the
# `0.83 - 0.87` peer range that react-native-reanimated and
# react-native-worklets declare, even though those builds explicitly target
# 0.87. Every dependency behaves this way against an RC, so a plain
# `npm install` fails with ERESOLVE.
#
# This is a range-matching technicality rather than a real conflict. Setting it
# here instead of passing --legacy-peer-deps by hand means a fresh clone
# installs correctly without anyone having to know the above.
#
# REMOVE THIS FILE when 0.87.0 ships stable — at that point the peer ranges
# match on their own, and leaving it in would hide genuine peer conflicts.
legacy-peer-deps=true
